  "benchmark_runner": "import json,subprocess,os,time,resource,statistics\nfrom pathlib import Path\nroot=Path('/home/ubuntu/code/rrubocop-wistia-parity'); project=Path('/tmp/rr-review-fixes-project');project.mkdir(exist_ok=True);(project/'Gemfile').write_text('');(project/'.rubocop.yml').write_text('AllCops:\\n  NewCops: enable\\n  TargetRubyVersion: 3.4\\nCops/NoSleep:\\n  Enabled: true\\n  Include: [\"**/*\"]\\n')\npath=project/'probe.rb'; bins={'before':'/tmp/rrubocop-before-review-f31620a','after':str(root/'target/release/rrubocop')};cache=Path('/tmp/rr-review-fixes-cache');cache.mkdir(exist_ok=True);(cache/'unavailable').write_text('benchmark-only unavailable backend');rows=[];outputs={}\ndef run(binary,scope,args,cwd=project,source=None):\n if source is not None:path.write_text(source)\n env={**os.environ,'RRUBOCOP_CACHE_DIR':str(cache/binary/scope if scope in ['sample','full'] else cache/'unavailable')};rss=Path('/tmp/rr-review-fixes-rss.txt');u=resource.getrusage(resource.RUSAGE_CHILDREN);start=time.perf_counter()\n p=subprocess.run(['/usr/bin/time','-q','-f','%M','-o',str(rss),bins[binary],'--cache','false','--format','json']+args,cwd=cwd,env=env,capture_output=True,text=True,timeout=120);e=resource.getrusage(resource.RUSAGE_CHILDREN)\n if p.returncode not in (0,1):raise RuntimeError((scope,p.stderr))\n data=json.loads(p.stdout);assert not any(o['cop_name']=='Lint/Syntax' for o in data['offenses']),(scope,data)\n rows.append({'binary':binary,'scope':scope,'wall':time.perf_counter()-start,'user':e.ru_utime-u.ru_utime,'system':e.ru_stime-u.ru_stime,'max_rss_kib':int(rss.read_text().strip()),'metadata':data['metadata']});outputs.setdefault(scope,{})[binary]={'offenses':data['offenses'],'source':path.read_text() if source is not None else None}\n Path('/tmp/rr-review-fixes-timings.json').write_text(json.dumps(rows,indent=2));Path('/tmp/rr-review-fixes-'+binary+'-'+scope+'.json').write_text(json.dumps(data,indent=2));print(rows[-1],flush=True)\nfor n in [4000,64000]:\n for repeat in range(3):\n  for b in (['before','after'] if repeat%2==0 else ['after','before']):run(b,'percent-'+str(n),['--only','Layout/SpaceAfterComma',str(path)],source='value = %w['+'word '*n+']\\n')\nfor scope,source in [('ascii-1m','sleep # '+'x'*1000000+'\\n'),('unicode-sparse-1m','sleep # '+'x'*1000000+'\u00e9\\n'),('unicode-dense-250k','sleep # '+'\ud83d\ude00'*250000+'\\n')]:\n for repeat in range(3):\n  for b in (['before','after'] if repeat%2==0 else ['after','before']):run(b,scope,['--only','Cops/NoSleep',str(path)],source=source)\nfor repeat in range(3):\n for b in (['before','after'] if repeat%2==0 else ['after','before']):run(b,'correct-8000',['--only','Layout/TrailingWhitespace','-A',str(path)],source='x = 1  \\n'*8000)\ncorpus=Path('/home/ubuntu/code/wistia-rrubocop-benchmark');inputs=json.load(open('/tmp/rr-performance-inputs.json'))\nfor repeat in range(3):\n for b in (['before','after'] if repeat%2==0 else ['after','before']):run(b,'sample',inputs['sample'],corpus)\nfor repeat in range(2):\n for b in (['before','after'] if repeat==0 else ['after','before']):run(b,'full',[],corpus)\ncomparisons={s:{'identical_offenses':v['before']['offenses']==v['after']['offenses'],'identical_source':v['before']['source']==v['after']['source']} for s,v in outputs.items()};Path('/tmp/rr-review-fixes-benchmark-comparisons.json').write_text(json.dumps(comparisons,indent=2))\nfor s in outputs:print(s,{b:statistics.median(r['wall'] for r in rows if r['scope']==s and r['binary']==b) for b in bins},comparisons[s],flush=True)\n",
