  "independent_directive_range_model_runner": "require 'rubocop';require 'json'\nrng=Random.new(119);cop='Layout/SpaceAfterComma';config=RuboCop::ConfigLoader.default_configuration;failures=[]\n1000.times do |index|\n switches=Array.new(8){[rng.rand(2)==0 ? 'disable' : 'enable', ['all','Layout',cop,'Lint'].sample(random:rng), rng.rand(3)]}\n source=switches.each_with_index.map{|(mode,name,kind),i| [kind==0 ? '' : kind==1 ? 'foo(1, 2) ' : '# note ',\"# rubocop:#{mode} #{name}\\nfoo(1, 2)\\n\"].join}.join\n p=RuboCop::ProcessedSource.new(source,3.4,'/tmp/probe.rb');p.registry=RuboCop::Cop::Registry.global;p.config=config\n actual=p.comment_config.cop_disabled_line_ranges[cop]||[];expected=[];start=nil\n switches.each_with_index do |(mode,name,kind),i|\n  next unless ['all','Layout',cop].include?(name)\n  line=i*2+1\n  if kind>0\n   expected << (line..line) if mode=='disable'\n  else\n   expected << (start..line) if start\n   start=mode=='disable' ? line : nil\n  end\n end\n expected << (start..Float::INFINITY) if start\n if actual!=expected\n  failures<<{index:index,source:source,actual:actual.map(&:to_s),expected:expected.map(&:to_s)}\n  break if failures.size>10\n end\nend\nFile.write('/tmp/rr-independent-directive-ranges.json',JSON.pretty_generate({cases:1000,failures:failures}));puts \"range cases=1000 failures=#{failures.size}\";puts failures.first.inspect unless failures.empty?\n",
