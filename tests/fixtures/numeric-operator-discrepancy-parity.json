[
  {
    "cop": "Lint/MultipleComparison",
    "path": "test.rb",
    "config": {
      "TargetRubyVersion": 3.4,
      "ActiveSupportExtensionsEnabled": true
    },
    "source": "(a).<(\n# parity audit\nb) < c\n",
    "expected": [
      {
        "line": 1,
        "column": 0,
        "message": "Use the `&&` operator to compare multiple values.",
        "correctable": true
      }
    ],
    "corrected": "(a).<(\n# parity audit\nb && b) < c\n",
    "rust_expected": [
      {
        "line": 1,
        "column": 0,
        "message": "Use the `&&` operator to compare multiple values.",
        "correctable": false
      }
    ],
    "rust_corrected": "(a).<(\n# parity audit\nb) < c\n",
    "reason": "Pinned Ruby rewrites the argument inside an explicit comparison call instead of splitting the comparison chain, repeatedly growing the expression. Report only to avoid changing its semantics or looping autocorrection."
  },
  {
    "cop": "Security/CompoundHash",
    "path": "test.rb",
    "config": {
      "Safe": false,
      "TargetRubyVersion": 3.4,
      "ActiveSupportExtensionsEnabled": true
    },
    "source": "def hash; a.hash.^(\n# parity audit\nb.hash); end\n",
    "expected": [
      {
        "line": 1,
        "column": 10,
        "message": "Use `[...].hash` instead of combining hash values manually.",
        "correctable": false
      }
    ],
    "corrected": "def hash; a.hash.^(\n# parity audit\nb.hash); end\n"
  },
  {
    "cop": "Style/RandomWithOffset",
    "path": "test.rb",
    "config": {
      "TargetRubyVersion": 3.4,
      "ActiveSupportExtensionsEnabled": true
    },
    "source": "10.-(\n# parity audit\nrand(1..3))\n",
    "expected": [
      {
        "line": 1,
        "column": 0,
        "message": "Prefer ranges when generating random numbers instead of integers with offsets.",
        "correctable": true
      }
    ],
    "corrected": "rand(7..9)\n"
  },
  {
    "cop": "Style/SlicingWithRange",
    "path": "test.rb",
    "config": {
      "Safe": false,
      "TargetRubyVersion": 3.4,
      "ActiveSupportExtensionsEnabled": true
    },
    "source": "(items).[](\n# parity audit\n0..-1)\n",
    "expected": [
      {
        "line": 1,
        "column": 8,
        "message": "Remove the useless `[]`.",
        "correctable": true
      }
    ],
    "corrected": "(items).(\n# parity audit\n0..-1)\n",
    "rust_expected": [
      {
        "line": 1,
        "column": 8,
        "message": "Remove the useless `[]`.",
        "correctable": false
      }
    ],
    "rust_corrected": "(items).[](\n# parity audit\n0..-1)\n",
    "reason": "Pinned Ruby removes only the explicit [] method token, changing slicing into a .call invocation. Report only instead of introducing a different method call."
  },
