    "path": "test.rb",
    "config": {
      "AutoCorrect": "contextual",
      "TargetRubyVersion": 3.4,
      "ActiveSupportExtensionsEnabled": true
    },
    "expected": [
      {
        "line": 4,
        "column": 4,
        "message": "Avoid leaving a trailing comma in attribute declarations.",
        "correctable": true,
        "length": 1,
        "severity": "warning"
      }
    ],
    "corrected": "class A\n attr_reader(\n# parity audit\n:foo\n def bar; 1; end)\nend\n",
    "rust_expected": [
      {
        "line": 4,
        "column": 4,
        "message": "Avoid leaving a trailing comma in attribute declarations.",
        "correctable": false,
        "length": 1,
        "severity": "warning"
      }
    ],
    "rust_corrected": "class A\n attr_reader(\n# parity audit\n:foo,\n def bar; 1; end)\nend\n",
    "reason": "Removing only the comma inside parenthesized attribute arguments produces invalid Ruby; retain a report-only offense."
  },
